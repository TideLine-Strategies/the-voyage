{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-voyage",
  "main": "src/entry.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "ACCOUNT_AUTH_URL": "https://xdghdnlwrizvnrzkddgw.supabase.co",
    "ACCOUNT_AUTH_PUBLIC_KEY": "sb_publishable_3SItPlSfk2-sP7xgGMG6Zw_WneEhxjg",
    "ACCOUNT_RECOVERY_URL": "https://premieros-preview.signallabs.workers.dev/"
  },
  "routes": [
    {
      "pattern": "voyage.tidelinestrats.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-voyage",
      "database_id": "9369a2a5-318c-4178-98df-a79de8d1d6ec",
      "migrations_dir": "migrations"
    },
    {
      "binding": "TIDELINE_DB",
      "database_name": "tideline-contact",
      "database_id": "0d9ef612-2f04-4754-8ab0-54e2b5888e21"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COMPANY_HUB",
        "class_name": "CompanyHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "company-operations-v1",
      "new_sqlite_classes": [
        "CompanyHub"
      ]
    }
  ],
  "build": {
    "command": "node scripts/stamp-release.mjs"
  }
}
